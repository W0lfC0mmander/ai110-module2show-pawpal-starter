classDiagram
    %% Proposed design for adding pets, scheduling care tasks, and viewing daily plans.
    class PawPalsApp {
        +Owner currentOwner
        +Scheduler schedule_service
        +addPet(name: String, species: String) Pet
        +scheduleTask(petId: int, task: Task, startAt: DateTime, notes: String) ScheduledTask
        +getTodaysTasks() List~ScheduledTask~
    }

    class Owner {
        +int id
        +String name
        +List~Pet~ pets
        +Map~Date, DailySchedule~ dailySchedules
        +int? dailyTimeBudgetMinutes
        +Time? preferredStartTime
        +addPet(pet: Pet) void
        +getAllTasks() List~Task~
        +findPet(petId: int) Pet
        +getScheduleFor(day: Date) DailySchedule?
        +getOrCreateSchedule(day: Date) DailySchedule
    }

    class Pet {
        +int id
        +String name
        +String species
        +Date birthDate
        +List~Task~ careTasks
        +addCareTask(task: Task) void
        +getCareTasks() List~Task~
    }

    class Task {
        +int id
        +String title
        +int durationMinutes
        +Priority priority
        +TaskStatus status
        +String description
        +String frequency
        +completed <<derived>>
        +markComplete() void
    }

    class Walk {
        +String location
        +float distanceKm
        +setLocation(location: String) void
    }

    class ScheduledTask {
        +Pet pet
        +Task task
        +DateTime startAt
        +DateTime endAt <<derived from task duration>>
        +String notes
        +reschedule(startAt: DateTime) void
        +isFor(date: Date) bool
    }

    class DailySchedule {
        +Date date
        +List~ScheduledTask~ tasks
        +addTask(task: ScheduledTask) void
        +isAvailable(startAt: DateTime, endAt: DateTime) bool
        +getTasksFor(date: Date) List~ScheduledTask~
        +getTodaysTasks(today: Date) List~ScheduledTask~
    }

    class Scheduler {
        +getTasks(owner: Owner) List~(Pet, Task)~
        +organizeTasks(owner: Owner) List~(Pet, Task)~
        +detectConflicts(owner: Owner, startAt: DateTime, endAt: DateTime) List~String~
        +scheduleTask(owner: Owner, pet: Pet, task: Task, startAt: DateTime, notes: String) ScheduledTask
        +completeTask(owner: Owner, scheduledTask: ScheduledTask) ScheduledTask?
        +getTodaysTasks(owner: Owner, today: Date) List~ScheduledTask~
        +checkAvailability(schedule: DailySchedule, startAt: DateTime, endAt: DateTime) bool
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class TaskStatus {
        <<enumeration>>
        SCHEDULED
        COMPLETE
        SKIPPED
    }

    PawPalsApp --> Owner : manages
    PawPalsApp --> Scheduler : uses
    Owner "1" o-- "0..*" Pet : owns
    Owner "1" *-- "0..*" DailySchedule : owns schedules
    Pet "1" o-- "0..*" Task : needs
    Task <|-- Walk
    Task --> Priority
    Task --> TaskStatus
    DailySchedule "1" *-- "0..*" ScheduledTask : contains
    ScheduledTask --> Task : schedules
    ScheduledTask --> Pet : for
    Scheduler ..> DailySchedule : creates and queries
    Scheduler ..> Owner : schedules within owner's calendar
